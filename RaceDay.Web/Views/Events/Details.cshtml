@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h1>@Model.Name</h1>

        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img src="@Model.BannerUrl"
                 class="img-fluid rounded mb-3"
                 style="max-height:350px; object-fit:cover;"
                 alt="@Model.Name" />
        }

        <span class="badge bg-primary">@Model.EventType</span>

        <p class="mt-3">@Model.Description</p>

        <hr />

        <p><strong>Date:</strong> @Model.EventDate</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Distance:</strong> @Model.DistanceKm km</p>
        <p><strong>Capacity:</strong> @Model.Capacity participants</p>

        @if (Context.Session.GetString("Role") == "Participant")
        {
            <a asp-controller="Participant"
               asp-action="Enrol"
               asp-route-eventId="@Model.Id"
               class="btn btn-primary">
                Enrol Now
            </a>
        }

        <a asp-action="Index" class="btn btn-outline-secondary mt-3">
            Back to Events
        </a>
    </div>
</div>
