@model RaceDay.Web.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2>Create a RaceDay Event</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="DistanceKm" class="form-label">
                    Distance (km)
                </label>
                <input asp-for="DistanceKm" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Create Event
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
